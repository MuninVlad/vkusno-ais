digraph BPMN {
  rankdir=LR; @STYLE@ newrank=true;
  node [shape=box, style="rounded,filled", fillcolor="#ffffff"];
  subgraph cluster_g { label="Гость"; style=filled; fillcolor="#f7f5f0"; color="#c9d2cd";
    s [label="", shape=circle, width=0.35, fillcolor="#e5f1ea", color="#2f7a5c", penwidth=2]; g1 [label="Сделать заказ"]; g2 [label="Оплатить"]; g3 [label="Получить заказ"];
    e [label="", shape=circle, width=0.35, fillcolor="#fbe7e5", color="#c8372d", penwidth=4]; }
  subgraph cluster_k { label="Кассир (АИС)"; style=filled; fillcolor="#fff9f1"; color="#c9d2cd";
    k1 [label="Внести позиции\nв АИС"]; x1 [label="×", shape=diamond, width=0.5, fixedsize=true, fillcolor="#fff4e3"];
    k2 [label="Найти/зарегистрировать\nклиента"]; k3 [label="Принять оплату,\nстатус «новый»"]; k5 [label="Выдать заказ,\nстатус «выдан»"]; }
  subgraph cluster_p { label="Кухня"; style=filled; fillcolor="#f2f8f4"; color="#c9d2cd";
    p1 [label="Приготовить,\nстатус «готовится»"]; p2 [label="Статус «готов»"]; }
  s -> g1 -> k1 -> x1; x1 -> k2 [label="есть карта\nлояльности"]; x1 -> k3 [label="нет"]; k2 -> k3; g2 -> k3 [style=dashed, arrowhead=empty, label="оплата"];
  k3 -> p1 -> p2 -> k5 -> g3 -> e;
  g1 -> g2 [style=invis];
}
